# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max
# LLM HTTP 超时（秒，默认 120）
LLM_TIMEOUT_SEC=120

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY
# Tavily HTTP 超时（秒，默认 120；官方 search 上限约 120）
TAVILY_TIMEOUT_SEC=120

# BrowseComp-Plus 固定语料评测（开启后 internet_search 不访问 Tavily）
# BROWSECOMP_PLUS_ENABLED=true
# BROWSECOMP_PLUS_CORPUS_DB=.benchmark_data/browsecomp_plus/corpus.sqlite3
# BROWSECOMP_PLUS_RETRIEVAL_LOG=tests/eval/results/browsecomp_plus/retrieval_log.jsonl
# BROWSECOMP_PLUS_TOP_K=5
# BROWSECOMP_PLUS_MAX_CONTEXT_CHARS=2048

# RAGFlow 配置
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# Harness 压缩模型（Phase 2，默认 qwen-turbo；设为 false 可禁用 LLM 压缩）
LLM_COMPRESSION_MODEL=qwen-turbo
HARNESS_LLM_COMPRESSION=true

# Mem0 长期记忆（Phase 3/15，可选；未安装时自动降级 SQLite/JSON）
# MEM0_ENABLED=true
# HARNESS_MEMORY_PROVIDER=sqlite   # sqlite | local | mem0

# 【Phase 15】生产级 Memory
# HARNESS_MEMORY_TENANT_ID=tenant_acme
# HARNESS_MEMORY_USER_ID=real_user_id
# HARNESS_MEMORY_EMBEDDING_ENABLED=true
# HARNESS_MEMORY_EMBEDDING_MODEL=text-embedding-v3
# HARNESS_MEMORY_STEP_INCREMENTAL=true
# HARNESS_MEMORY_PII_REDACT=true

# Harness 配置覆盖（Phase 4，可选）
# HARNESS_JSONL_LOG_ENABLED=true
# HARNESS_USAGE_TRACKING_ENABLED=true
# HARNESS_LLM_PRICING_JSON={"qwen-max":{"input":1.6,"output":6.4}}
# HARNESS_VALIDATION_STRICT=false
# HARNESS_LANGFUSE_ENABLED=true
# HARNESS_MEMORY_PROVIDER=local
# HARNESS_MCP_ENABLED=true          # 启用全部 MCP Server（Tavily/MySQL/RAGFlow/Files）
# HARNESS_MCP_TAVILY=true
# HARNESS_MCP_MYSQL=true
# HARNESS_MCP_RAGFLOW=true
# HARNESS_MCP_FILES=true
# HARNESS_MCP_POOL_ENABLED=true     # 常驻连接池（Phase 16）
# HARNESS_MCP_SYNC_ON_STARTUP=true  # 启动 list_tools 同步 Registry
# HARNESS_MCP_GATEWAY_TOKEN=        # 非空时需匹配 gateway OAuth
# HARNESS_MCP_GATEWAY_RATE_LIMIT=120
# HARNESS_HITL_ENABLED=true

# Langfuse 可观测性（Phase 2，可选；未配置时自动降级）
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
