# 本地开发（浏览器与后端在同一台机器）可保持默认
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# 远程访问服务器上的 Vite 开发页时：
# 1) 不要设置 localhost（浏览器会连到你自己的电脑）
# 2) 直接删掉 .env.local，让 Vite 代理自动转发 /api 和 /ws
# 或显式指定服务器 IP：
# VITE_API_BASE_URL=http://192.168.x.x:8000
# VITE_WS_BASE_URL=ws://192.168.x.x:8000
